# ---------------------------------------------------------------------------
# You do NOT need this file to run the project locally. With no Firebase web
# config, the dev server signs users in against the local Auth emulator that
# `npm run dev` starts, and the map uses OpenStreetMap (no key).
# Fill these in only to use a real Firebase project and Google Maps.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Leave VITE_API_BASE_URL EMPTY for both normal setups:
#   dev     -> Vite proxies /api to localhost:8080 (see vite.config.ts)
#   deploy  -> the API serves this build, so /api is same-origin
# Only set it if you host the frontend separately from the API, e.g.
#   VITE_API_BASE_URL=https://radius-api-xxxx.a.run.app
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

# Firebase Web App config — Project settings > General > Your apps > Web app.
# These are public by design; security comes from Firestore rules and the API,
# never from hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=radius.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=radius
VITE_FIREBASE_STORAGE_BUCKET=radius.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LOCAL DEVELOPMENT ONLY — points sign-in at the Firebase Auth emulator so the whole
# app is usable without a Google Cloud project. Start it with:
#   firebase emulators:start --only firestore,auth
# Then set the backend's FIREBASE_AUTH_EMULATOR_HOST to the same value.
# MUST be left empty for any real deployment.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Maps JavaScript API key. Restrict it by HTTP referrer in the Cloud Console
# before using it anywhere public.
VITE_GOOGLE_MAPS_API_KEY=
