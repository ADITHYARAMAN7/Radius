{
 "displayName": "Nearby-Events - live monitoring",
 "mosaicLayout": {
  "columns": 12,
  "tiles": [
   {
    "xPos": 0,
    "yPos": 0,
    "width": 12,
    "height": 2,
    "widget": {
     "title": "About",
     "text": {
      "format": "MARKDOWN",
      "content": "**Nearby-Events (Cloud Run, asia-south1).** Traffic, speed and errors come from Cloud Run. App activity and AI health come from log-based metrics on the API structured logs. The uptime check calls /api/health every 5 minutes and emails on failure."
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 2,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Requests per second by response class",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nearby-events\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_RATE",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "metric.label.response_code_class"
           ]
          }
         }
        },
        "plotType": "STACKED_BAR"
       }
      ],
      "yAxis": {
       "label": "req/s",
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 2,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Response time (p50 / p95, ms)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nearby-events\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_DELTA",
           "crossSeriesReducer": "REDUCE_PERCENTILE_50",
           "groupByFields": []
          }
         }
        },
        "plotType": "LINE",
        "legendTemplate": "p50"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nearby-events\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_DELTA",
           "crossSeriesReducer": "REDUCE_PERCENTILE_95",
           "groupByFields": []
          }
         }
        },
        "plotType": "LINE",
        "legendTemplate": "p95"
       }
      ],
      "yAxis": {
       "label": "ms",
       "scale": "LINEAR"
      }
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 6,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Uptime check (/api/health) - share of checks passing",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\" AND metric.label.check_id=\"nearby-events-health-7yUxI29KmOc\"",
          "aggregation": {
           "alignmentPeriod": "300s",
           "perSeriesAligner": "ALIGN_FRACTION_TRUE",
           "crossSeriesReducer": "REDUCE_MEAN",
           "groupByFields": []
          }
         }
        },
        "plotType": "LINE"
       }
      ]
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 6,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Running instances (scales to zero when idle)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nearby-events\"",
          "aggregation": {
           "alignmentPeriod": "60s",
           "perSeriesAligner": "ALIGN_MAX",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": [
            "metric.label.state"
           ]
          }
         }
        },
        "plotType": "STACKED_AREA"
       }
      ]
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 10,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Board activity per hour: events posted and RSVPs",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/events_created\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "events posted"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/rsvps_created\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "RSVPs"
       }
      ]
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 10,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Gemini / Vertex AI health per hour",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/poster_extractions\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "Snap-a-Poster reads OK"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/ai_retries\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "retried on fallback model"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/ai_failures\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "failed / used rules"
       }
      ]
     }
    }
   },
   {
    "xPos": 0,
    "yPos": 14,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Server errors per hour (5xx and ERROR logs)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/app_errors\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "ERROR logs"
       },
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"nearby-events\" AND metric.label.response_code_class=\"5xx\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "5xx responses"
       }
      ]
     }
    }
   },
   {
    "xPos": 6,
    "yPos": 14,
    "width": 6,
    "height": 4,
    "widget": {
     "title": "Expiry sweeps by Cloud Scheduler (hourly)",
     "xyChart": {
      "dataSets": [
       {
        "timeSeriesQuery": {
         "timeSeriesFilter": {
          "filter": "metric.type=\"logging.googleapis.com/user/expiry_sweeps\" AND resource.type=\"cloud_run_revision\"",
          "aggregation": {
           "alignmentPeriod": "3600s",
           "perSeriesAligner": "ALIGN_SUM",
           "crossSeriesReducer": "REDUCE_SUM",
           "groupByFields": []
          }
         }
        },
        "plotType": "STACKED_BAR",
        "legendTemplate": "sweeps"
       }
      ]
     }
    }
   }
  ]
 }
}