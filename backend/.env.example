# ============================================================================
# You do NOT need this file to run the project locally.
#
#   npm run install:all
#   npm run dev
#
# With no .env at all the app runs in LOCAL MODE: Firestore and Auth come from the
# Firebase emulators (started for you), photos are stored on disk, and the AI
# assistant uses its built-in rule-based engine. Nothing touches Google Cloud.
#
# Fill in the values below only to point the app at a real Google Cloud project.
# Setting GCP_PROJECT_ID or GOOGLE_APPLICATION_CREDENTIALS switches local mode off;
# use `npm run dev:cloud` in that case so the emulators are not started.
# ============================================================================

NODE_ENV=development
PORT=8080

GCP_PROJECT_ID=radius
FIREBASE_PROJECT_ID=radius
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

GCS_BUCKET=radius-event-images

AI_PROVIDER=api
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# One retry goes here when the main model is overloaded (503 "high demand").
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
VERTEX_LOCATION=global

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The endpoint stays DISABLED if this is left empty, which is the safest default.
MAINTENANCE_TOKEN=
SERVE_STATIC=false

# Local development without a Google Cloud project at all.
# Start both with: firebase emulators:start --only firestore,auth
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
