{
  "name": "radius-api",
  "version": "1.0.0",
  "private": true,
  "description": "Radius API — Express + Firestore + Cloud Storage + Gemini, deployed on Cloud Run",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx ../scripts/seed-events.ts",
    "seed:clear": "tsx ../scripts/seed-events.ts --clear",
    "verify": "tsx src/scripts/verify.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "@google-cloud/tasks": "^7.2.1",
    "@google-cloud/text-to-speech": "^7.1.1",
    "@google-cloud/translate": "^10.1.1",
    "@google-cloud/vision": "^6.1.1",
    "@google/genai": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.0",
    "helmet": "^7.1.0",
    "multer": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
