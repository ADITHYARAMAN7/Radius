# ============================================================================
# Nearby-objects — root reference for every environment variable in the project
# Copy the relevant blocks into backend/.env and frontend/.env
# ============================================================================

# ---------------------------------------------------------------------------
# BACKEND  ->  backend/.env
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Google Cloud project that owns Firestore, Cloud Storage and (optionally) Vertex AI
GCP_PROJECT_ID=nearby-objects
FIREBASE_PROJECT_ID=nearby-objects

# Service account used by firebase-admin.
# LOCAL: path to the downloaded JSON key.
# CLOUD RUN: leave BOTH blank — Application Default Credentials are used automatically.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Cloud Storage bucket that holds event images (no gs:// prefix)
GCS_BUCKET=nearby-objects-event-images

# Gemini. Use ONE of the two modes below.
#  mode "api"    -> Gemini Developer API, needs GEMINI_API_KEY
#  mode "vertex" -> Vertex AI, needs GCP_PROJECT_ID + VERTEX_LOCATION, no key
AI_PROVIDER=api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# One retry goes here when the main model is overloaded (503 "high demand").
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
VERTEX_LOCATION=us-central1

# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Shared secret for the Cloud Scheduler expiration sweep (POST /api/maintenance/expire)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The endpoint stays DISABLED if this is left empty, which is the safest default.
MAINTENANCE_TOKEN=

# Serve the built frontend from the API process (single Cloud Run service).
# true in production, false while running Vite separately.
SERVE_STATIC=false

# Local development against the Firebase emulators instead of real Firestore/Auth.
# Leave blank to use the real Google Cloud services. See README "Run locally with emulators".
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# FRONTEND  ->  frontend/.env     (VITE_ vars are PUBLIC — never put secrets here)
# ---------------------------------------------------------------------------
# Leave empty: dev uses the Vite proxy, deploy serves the SPA from the API itself.
# Only set this for a split deployment (frontend hosted apart from the API).
VITE_API_BASE_URL=

# Firebase Web App config (Project settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nearby-objects.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nearby-objects
VITE_FIREBASE_STORAGE_BUCKET=nearby-objects.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LOCAL DEVELOPMENT ONLY — sign-in against the Firebase Auth emulator. MUST be empty in any real deployment.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Google Maps JavaScript API key — restrict by HTTP referrer in the Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
